# Supabase project credentials.
# The anon key is safe to expose: RLS enforces row-level access (fase 1).
# Copy to .env.local and fill with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin credentials (R8). NEVER exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY grants full admin access (auth admin API): it lives
# only in server environment variables (Vercel), is never NEXT_PUBLIC_*, and is
# never committed with a real value here. Consumed solely by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app: se usa para armar los links que se mandan a terceros
# (portal del alumno, seguimiento de reparaciones). Sin esto, el link se arma
# con el origen de la página actual: si el profe trabaja en su dev local
# (localhost), el alumno recibe un link que no puede abrir.
# En Vercel: production = https://<tu-dominio>. Preview: opcional (cae al
# origen del propio preview). En local: la URL por la que tu celu alcanza tu PC.
NEXT_PUBLIC_APP_URL=